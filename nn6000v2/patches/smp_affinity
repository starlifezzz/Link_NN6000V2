#!/bin/sh /etc/rc.common
######################################################################
# vim: set ft=bash
# shellcheck disable=2155,3019,3043,3057,3060
######################################################################

START=93

PROG=smp_affinity

log_msg() {

    local irq_name="$1" affinity="$2" irq="$3" msg

    msg="$(printf "Pinning IRQ($irq) %-24s to CPU ${affinity}\n" "$irq_name")"

    logger -t "$PROG" "$msg"
}

######################################################################
### Takes a comma, space separated, or range list of CPU numbers and
## returns a bitmask of CPUs.
## cpus_to_bitmask "0,1,2,3" -> f
## cpus_to_bitmask "0 1 2 3" -> f
## cpus_to_bitmask "0-3"     -> f
## cpus_to_bitmask "3"       -> 8
#######################################################################

cpus_to_bitmask() {

    local bitmask=0
    # shellcheck disable=2048
    for range in ${*//,/ }; do
        start="${range%-*}"
        end="${range#*-}"
        if [ -z "$end" ]; then
            bitmask="$((bitmask | 1 << start))"
        else
            bitmask="$((bitmask | ((1 << (end - start + 1)) - 1) << start))"
        fi
    done
    printf '%x' $bitmask
}

######################################################################
### Takes a bitmask of CPUs and returns a space separated list of
## CPU numbers.
## bitmask_to_cpus f -> 0 1 2 3
######################################################################

bitmask_to_cpus() {

    case "$1" in 0x*) ;; *) set -- "0x$1" ;; esac
    local bitmask="$(printf '%d' "$1")"

    local cpus=""
    for i in $(seq 0 63); do
        if [ $((bitmask & 1)) -ne 0 ]; then
            cpus="$cpus $i"
        fi
        bitmask=$((bitmask >> 1))
    done
    echo "${cpus# }"
}

######################################################################
### Sets the affinity of the IRQs with the given name to the given CPU.
## 1st argument: IRQ name ("reo2host-destination-ring1") (req)
## 2nd argument: CPU number (req)
######################################################################

set_affinity() {
    local irq_name="$1" affinity="$2" occurrence="${3:-1}" bitmask irq
    awk -v irq_name="$1" -v occurrence="$occurrence" '
        BEGIN{count=0}
        $NF==irq_name {
            if(++count==occurrence){
                sub(/:$/,"",$1)
                print $1
            }
        }' /proc/interrupts | while read -r irq; do
        $enable_log && {
            log_msg "$irq_name" "$affinity" "$irq"
        }
        bitmask=$(cpus_to_bitmask "$affinity") && echo "$bitmask" >"/proc/irq/$irq/smp_affinity"
    done
}

# 检测 WiFi 是否存在（ath11k 驱动未加载则视为无 WiFi 版）
detect_wifi() {
    [ -d "/sys/kernel/debug/ieee80211/phy0" ] && return 0
    [ -d "/sys/kernel/debug/ieee80211/phy1" ] && return 0
    return 1
}

######################################################################
# 中断分配表（数据驱动）：每行 "<IRQ 名> <目标 CPU> [第几次出现]"
#   CPU 写法见 cpus_to_bitmask: 单核 3 / 区间 0-3 / 列表 0,1
# 改策略只改表，不再散落在 if 分支里；顺序即绑定顺序（影响仅日志顺序）。
# 2026-10-21 真机: IPQ6018 /proc/interrupts 无 edma_* 中断（以太网为
#   bam_dma + nss_queue*），原表中 edma_* 行均为不匹配的空操作，已移除。
######################################################################
affinity_profile() {
    case "$1" in
    2core)          # 双核：以太网/NSS 集中 CPU0
        cat <<'EOF'
nss_queue0 0-1 1
bam_dma 0 1
EOF
        ;;
    2core_wifi)     # 双核 + WiFi：WiFi 环 0/1 分载
        cat <<'EOF'
reo2host-destination-ring1 0 1
reo2host-destination-ring2 0 1
reo2host-destination-ring3 1 1
reo2host-destination-ring4 1 1
wbm2host-tx-completions-ring1 0 1
wbm2host-tx-completions-ring2 1 1
wbm2host-tx-completions-ring3 1 1
EOF
        ;;
    4core_wifi)     # 四核 + WiFi：WiFi 占 0-3，以太网让到 CPU3，NSS 用 2-3
        cat <<'EOF'
reo2host-destination-ring1 0 1
reo2host-destination-ring2 1 1
reo2host-destination-ring3 2 1
reo2host-destination-ring4 3 1
wbm2host-tx-completions-ring1 1 1
wbm2host-tx-completions-ring2 2 1
wbm2host-tx-completions-ring3 3 1
ppdu-end-interrupts-mac1 1 1
ppdu-end-interrupts-mac2 2 1
ppdu-end-interrupts-mac3 3 1
nss_queue0 2-3 1
EOF
        ;;
    4core_nowifi)   # 四核纯有线：全部打散，最大化吞吐
        cat <<'EOF'
nss_queue0 0-3 1
EOF
        ;;
    esac
}

apply_profile() {
    local p
    for p in $1; do
        affinity_profile "$p" | while read -r irq_name cpu occ; do
            [ -n "$irq_name" ] || continue
            set_affinity "$irq_name" "$cpu" "${occ:-1}"
        done
    done
}

enable_affinity() {
    local cpu_count has_wifi=0 profile
    cpu_count=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null || echo 4)

    if detect_wifi; then
        has_wifi=1
    else
        logger -t "$PROG" "未检测到 WiFi 设备，使用纯有线网络优化策略"
    fi

    if [ "$cpu_count" -lt 4 ]; then
        logger -t "$PROG" "检测到 $cpu_count 核心 CPU，使用简化中断分配策略"
        profile=2core
        [ "$has_wifi" -eq 1 ] && profile="2core 2core_wifi"
    else
        logger -t "$PROG" "检测到 $cpu_count 核心 CPU"
        if [ "$has_wifi" -eq 1 ]; then
            logger -t "$PROG" "使用 WiFi+有线混合中断分配策略"
            profile=4core_wifi
        else
            logger -t "$PROG" "使用纯有线性能优化中断分配策略"
            profile=4core_nowifi
        fi
    fi

    apply_profile "$profile"

    # 4 核场景 BAM DMA 有 3 个队列，需分别钉核（occurrence 2/3），表里放不下
    if [ "$cpu_count" -ge 4 ]; then
        set_affinity 'bam_dma' 1 1
        set_affinity 'bam_dma' 2 2
        set_affinity 'bam_dma' 3 3
    fi

    # 设置默认中断亲和性为所有核心
    if [ -f /proc/irq/default_smp_affinity ]; then
        echo "f" > /proc/irq/default_smp_affinity 2>/dev/null || true
    fi
}

boot() {

    local enable

    config_load smp_affinity

    config_get_bool enable "general" enable 1
    config_get_bool enable_log "general" enable_log 1

    [ "$enable" -eq 1 ] && enable=true || enable=false
    [ "$enable_log" -eq 1 ] && enable_log=true || enable_log=false

    $enable && enable_affinity
}
