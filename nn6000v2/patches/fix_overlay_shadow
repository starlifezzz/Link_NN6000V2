#!/bin/sh /etc/rc.common
######################################################################
# vim: set ft=sh
# fix_overlay_shadow - 修复被 overlay 旧副本遮蔽的固件托管文件
#
# 背景（2026-10 三次实证的系统性问题）:
#   sysupgrade 保留 /overlay 时，旧固件时代的文件副本会遮蔽新 /rom 中
#   的同名文件，导致 HEAD 上的修复到不了设备：
#   - init.d 脚本（实例: fix_firewall_harden 修复版被旧副本遮蔽）
#   - uci-defaults（旧失败脚本遮蔽新版，重跑旧逻辑）
#   - /etc/sysctl.d/zz-custom.conf
#   - apk 数据库（旧固件 db 遮蔽 rom db，kernel 记录 6.18.44 vs
#     实际运行 6.18.52 → apk upgrade 会拉入 vermagic 不匹配的 kmod）
#
# 处理规则:
#   A) 托管文件白名单: 以内容 md5 状态判定（不能用 mtime —— /rom 文件 mtime
#      是构建树检出时间，可能比 overlay 副本旧，会让 `-ot` 恒假）。
#      overlay 副本内容==rom → rom 已生效；内容!=rom 且 rom/副本 md5 均未变
#      → 视为设备侧本地改动保留；否则删除副本让 rom 生效。
#      白化（overlay 删除标记＝字符设备 0,0）同样遮蔽 rom —— uci-default 被
#      消费后留下的白化会让 rom 新版永不生效。rom 版本变了则移除白化，
#      令该 default 下次开机重跑（2026-10-17 实证: 998_set_nss_freq 白化导致
#      NSS 长期停在 mid=748.8MHz，未达预期的 high=1497.6MHz）。
#   B) apk db: 当 overlay db 与 /rom 基线不一致时重建: kernel V: 不同（整库
#      来自旧固件）、存在死记录、rom 有而 overlay db 缺的包（新镜像新增包）、
#      或 rom world 的版本钉死（base-files=/kernel=/libc=）在 db 中不满足，
#      均触发重建。以 rom db 为底 + 保留 overlay 独有包（运行期安装的
#      openclash/lucky 等），重建前备份原库。
#      2026-10 实测（r0-63c7fdb -> r0-f9b0ce7）: kernel 未变、无死记录，
#      但 base-files 换代 + 新增 ucode-mod-math；只看 kernel 会误判健康，
#      apk add/fix 全部 breaks。
#      死记录 = overlay 独有且 D:kernel= 与当前内核不匹配的旧 kmod，
#      及依赖它们的级联包（2026-10 实测: 死 kmod-nft-fullcone 与新镜像
#      fullconenat-sonic 冲突、死 kmod-ipt-ipopt/nft-compat 钉死 6.18.44，
#      使 apk add/del/fix 全部 rc=99 无法自愈；这些记录对应 .ko 已随旧
#      /rom 消失，属幻影记录，必须剔除）。
#   C) apk world: 每次开机核对（幂等）: rom world 为底 + overlay 独有包名。
#      overlay world 会残留旧镜像版本钉死（kernel=6.18.44/base-files=1~4b85d5d，
#      2026-10 实测使 apk add/fix 全部 breaks world 失败），
#      且 db 重建(B) 不碰 world，必须独立同步。
#   D) 幻影包（2026-10-22 新增）: 镜像已从 .config 裁掉、但 overlay db/world
#      记录被 B/C 规则误当"运行期安装包"保留的包（文件实际已全部消失）。
#      以 stale_scan 幻影判定剔除（fail-safe 与判据见 stale_scan 注释），
#      否则每开机触发 world 重写 + bak 文件累积（ipq-wifi-link_nn6000 实证）。
#
# DRYRUN=1: 只打印将执行的动作，不修改任何文件（部署前验证用）。
#
# 时序: START=01 —— 必须早于所有被托管脚本（11/18/19/29/93）。
#       盲区已知并已补（2026-10-22 设备实测: logd 服务名是 log、START=12，
#       本脚本 START=01 更早 → 开机阶段 logger 写不进环形缓冲，事后 logread
#       查无记录）。故每条判定/动作另落盘到 /etc/.fix_overlay_shadow.report
#       （见 report()），时间前缀用单调 uptime 而非墙钟（早启动钟可偏移数小时）。
#       健康空跑也写汇总行 —— 有汇总=跑过且无漂移，无文件=没跑。
# 注意: 本脚本随新固件刷入后才生效；对当前旧固件设备执行也安全
#       （首次无记录时非白化副本一律让 rom 生效；白化则保留不动）。
######################################################################

START=01

PROG=fix_overlay_shadow

# 固件托管文件白名单（均由本仓库 scripts/system.sh、build.sh 安装进镜像；
# 运行期不应修改 —— 修改应提交仓库而非改设备）
MANAGED_FILES="
/etc/init.d/nss_tune
/etc/init.d/fix_firewall_harden
/etc/init.d/system_tune
/etc/init.d/fix_luci_rpcd
/etc/init.d/smp_affinity
/etc/init.d/fix_overlay_shadow
/etc/init.d/emmc_health
/usr/bin/luci_diag
/usr/bin/nss_diag.sh
/sbin/cpuusage
/sbin/cpuinfo
/usr/lib/lua/luci/controller/istore_backend.lua
/usr/share/rpcd/ucode/luci
/usr/share/ucode/luci/sys.uc
/usr/share/ucode/luci/version.uc
/usr/share/ucode/luci/zoneinfo.uc
/usr/lib/ucode/luci/core.so
/usr/share/ucode/luci/template/header.ut
/usr/share/ucode/luci/template/themes/argon/header.ut
/usr/share/ucode/luci/template/themes/argon/footer.ut
/usr/share/ucode/luci/template/themes/argon/header_login.ut
/usr/share/ucode/luci/template/themes/argon/footer_login.ut
/etc/sysctl.d/zz-custom.conf
/etc/nginx/conf.d/quickstart_icons.locations
/www/luci-static/resources/protocol/wwan.js
/etc/uci-defaults/990_set_argon_primary
/etc/uci-defaults/991_custom_settings
/etc/uci-defaults/992_network_config.sh
/etc/uci-defaults/994_set_opkg_repos
"

# 已从镜像移除的旧文件（2026-10-20 P1/P2 固化）：
# overlay 若还残留副本或白化，开机清掉 —— 否则备份还原带回的旧脚本
# 会继续执行旧逻辑（旧 fix_luci_ucode 用 cp 覆盖，与新 rom 内容打架）。
LEGACY_FILES="
/etc/init.d/fix_luci_ucode
/etc/init.d/fix_istorex
/etc/uci-defaults/996_fix_luci_homepage
/etc/uci-defaults/997_install_nginx_icons
/etc/uci-defaults/998_set_nss_freq
/etc/nginx/conf.d/quickstart_icons.location
"

# 落盘报告（补 logd 盲区，见文件头「时序」）:
#   START=01 早于 log(START=12)，开机阶段 logger 无效 → 判定/动作写持久文件。
#   前缀用 /proc/uptime 单调秒: 开机墙钟可大幅偏移（早启动按 UTC/滞后数小时），
#   墙钟不可作归因依据；开机序反推（uptime 回退=新一次开机）。
REPORT_FILE="/etc/.fix_overlay_shadow.report"
ACTIONS=0

report() {
    local up
    up=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)
    # 2>/dev/null 必须写在 >> 之前: 重定向按序执行，否则 /etc 不可写时
    # 报错会漏到控制台。写失败仅静默跳过（state 文件同样依赖 /etc 可写，
    # 若其也失败则整体已不可用，不在本函数内扩错）。
    printf '[+%ss] %s\n' "${up:-?}" "$*" 2>/dev/null >> "$REPORT_FILE" || return 0
    # 轮转: 超 768 行只留最近 512 —— 报告是诊断线索，防无限膨胀；state 文件不参与
    local n
    if [ -f "$REPORT_FILE" ]; then
        n=$(awk 'END{print NR+0}' "$REPORT_FILE" 2>/dev/null)
        if [ "${n:-0}" -gt 768 ]; then
            tail -n 512 "$REPORT_FILE" > "$REPORT_FILE.tmp" && \
                mv -f "$REPORT_FILE.tmp" "$REPORT_FILE"
        fi
    fi
}

log() {
    if [ -n "$DRYRUN" ]; then
        echo "[DRYRUN] $*"
    else
        logger -t "$PROG" "$*"
        echo "$*"
        ACTIONS=$((ACTIONS + 1))
        report "$*"
    fi
}

# ---------- A) 托管文件同步 ----------
# 判据用「内容 md5」而非 mtime。
#   2026-10-20 实测: /rom 内文件 mtime 是构建树检出时间（Oct 15 21:41），
#   比 overlay 副本（还原 iStore 备份带入，Oct 17 23:30）旧 → `[ upper -ot
#   rom ]` 恒假 → 新固件的修复永远被旧副本遮蔽（本次 fix_overlay_shadow 新
#   逻辑即因此未生效，apk db 仍停在 518）。
# 规则: 托管文件以 rom 为准（本仓库约定这些文件运行期不应修改）。
#   非白化副本: 内容==rom → 已生效；内容!=rom → 删除副本让 rom 生效。
#   白化: 遮蔽 rom 且 [ -f ] 恒假。rom 内容变了才移除白化令 uci-default 重跑；
#         否则保持（避免每次开机重复消费）。用状态文件记录上次决策时的
#         rom md5 —— 没有它就只能靠 mtime，而 mtime 不可信。
STATE_FILE="/etc/.fix_overlay_shadow.state"

# 打印路径的记录（rom md5）；无记录则空
state_get() {
    [ -f "$STATE_FILE" ] || return 0
    awk -v p="$1" '$2 == p { print $1; exit }' "$STATE_FILE"
}

# $1=path $2=rom_md5
state_set() {
    local tmp="$STATE_FILE.new"
    if [ -f "$STATE_FILE" ]; then
        awk -v p="$1" '$2 != p' "$STATE_FILE" > "$tmp"
    else
        : > "$tmp"
    fi
    printf '%s %s\n' "$2" "$1" >> "$tmp"
    mv -f "$tmp" "$STATE_FILE"
}

md5_of() {
    md5sum "$1" 2>/dev/null | awk '{print $1}'
}

# 清理已下线文件的 overlay 残留（副本或白化）。
# 只处理 /rom 中已不存在的路径，避免误删仍随固件提供的文件。
prune_legacy() {
    local f upper
    for f in $LEGACY_FILES; do
        upper="/overlay/upper$f"
        [ -e "$upper" ] || continue
        [ -e "/rom$f" ] && continue
        if [ -n "$DRYRUN" ]; then
            log "DRYRUN: would prune legacy overlay entry: $f"
        else
            rm -f "$upper"
            log "pruned legacy overlay entry: $f"
        fi
    done
}

sync_managed() {
    local f upper rmd5 rec
    [ -d /rom ] || return 0
    for f in $MANAGED_FILES; do
        upper="/overlay/upper$f"
        [ -f "/rom$f" ] || continue
        rmd5=$(md5_of "/rom$f")
        [ -n "$rmd5" ] || continue
        rec=$(state_get "$f")

        # overlay 无副本 → rom 已生效，无需处理
        [ -e "$upper" ] || continue

        # overlay"白化"（删除标记＝字符设备 0,0）
        if [ -c "$upper" ]; then
            if [ -z "$rec" ]; then
                if [ -n "$DRYRUN" ]; then
                    log "DRYRUN: would record whiteout: $f"
                else
                    state_set "$f" "$rmd5"
                    log "whiteout first seen, keep: $f"
                fi
            elif [ "$rec" = "$rmd5" ]; then
                log "whiteout up-to-date, keep: $f"
            else
                if [ -n "$DRYRUN" ]; then
                    log "DRYRUN: would remove whiteout: $f (rom updated)"
                else
                    rm -f "$upper"
                    state_set "$f" "$rmd5"
                    log "removed whiteout: $f (rom updated, uci-default re-runs)"
                fi
            fi
            continue
        fi

        if cmp -s "$upper" "/rom$f"; then
            continue
        fi
        if [ -n "$DRYRUN" ]; then
            log "DRYRUN: would remove stale overlay copy: $f (content != rom)"
        else
            rm -f "$upper"
            log "removed stale overlay copy: $f (content != rom, rom wins)"
        fi
    done
}

# ---------- B) apk 数据库重建 ----------
db_kernel_v() {
    awk '/^P:kernel$/{k=1;next} k&&/^V:/{sub(/^V:/,"");print;exit}' "$1" 2>/dev/null
}

# 死记录扫描。参数: <rom_db> <upper_db>
# 输出: 首行 "<overlay独有数> <剔除总数> <幻影数> <探针ok>"，其后每行一个被剔除包名。
# 死记录 = overlay 独有包中 D:kernel= 与 rom kernel V: 不匹配者，
# 以及依赖死记录的 overlay 独有包（依赖闭包，迭代至不动点）。
# 幻影包 = overlay 独有 + 至少 1 条 F: + **全部** F: 路径在合并视图均不存在。
#   （2026-10-22 实证: 镜像从 .config 裁掉 ipq-wifi 后，其记录被本脚本"保留
#     overlay 独有包"规则留存，F: 为 rootfs-overlay/… staging 路径永不存在，
#     每开机触发 world 重写+bak 累积。）幻影作为依赖闭包的种子，与死记录
#   同管道剔除（db 与 world 共用本函数，口径天然一致）。
#   fail-safe: BEGIN 双向探针（/etc 必在 + 已知必缺路径必不在）任一不符 →
#   整段幻影判定禁用（退回纯 stale 规则）；路径含 $ ` " \ 保守视为存在不剔除；
#   F: 为空的元包不参与判定。任何不确定 → 不剔除。
# 2026-10 设备实测最终集合一致性（所有普通依赖可解析、无冲突违反）= 0/0。
stale_scan() {
    awk '
        BEGIN {
            RS = ""
            probe = (system("[ -e /etc ]") == 0) && \
                    (system("[ -e /etc/.phantom_probe_no_such ]") != 0)
        }
        function pkg_of(b,   n, a, i) {
            n = split(b, a, "\n")
            for (i = 1; i <= n; i++)
                if (substr(a[i], 1, 2) == "P:") return substr(a[i], 3)
            return ""
        }
        function field_of(b, key,   n, a, i, kl) {
            kl = length(key)
            n = split(b, a, "\n")
            for (i = 1; i <= n; i++)
                if (substr(a[i], 1, kl+1) == key ":") return substr(a[i], kl+2)
            return ""
        }
        NR == FNR {
            if ($0 == "") next
            p = pkg_of($0); if (p == "") next
            rom[p] = 1
            if (p == "kernel") kv = field_of($0, "V")
            next
        }
        {
            if ($0 == "") next
            p = pkg_of($0); if (p == "" || p in rom) next
            np++; on[np] = p; od[np] = field_of($0, "D")
            # 收集 F: 路径（幻影判定用）；fn=条数（0 即元包，不参与判定）
            nb = split($0, ab, "\n")
            for (ib = 1; ib <= nb; ib++)
                if (substr(ab[ib], 1, 2) == "F:") {
                    fn[np]++
                    pf[np] = pf[np] substr(ab[ib], 3) "\n"
                }
        }
        END {
            # 1) kernel 依赖不匹配
            for (i = 1; i <= np; i++) {
                nt = split(od[i], tok, " ")
                for (j = 1; j <= nt; j++)
                    if (substr(tok[j], 1, 7) == "kernel=" && substr(tok[j], 8) != kv) {
                        drop[on[i]] = 1; break
                    }
            }
            # 1.5) 幻影包（探针通过才启用；见文件头 fail-safe 说明）
            ph = 0
            if (probe) {
                for (i = 1; i <= np; i++) {
                    if (on[i] in drop) continue
                    if (fn[i] == 0) continue
                    k = split(pf[i], pa, "\n")
                    all = 1
                    for (j = 1; j <= k; j++) {
                        if (pa[j] == "") continue
                        # 含 shell 特殊字符的路径保守视为存在（防误判误删）
                        if (pa[j] ~ /[$`"\\]/) { all = 0; break }
                        if (system("[ -e \"/" pa[j] "\" ]") == 0) { all = 0; break }
                    }
                    if (all) { drop[on[i]] = 1; ph++ }
                }
            }
            # 2) 依赖闭包（跳过 cmd:/so:/pc: 与 !冲突项；剥版本约束）
            do {
                ch = 0
                for (i = 1; i <= np; i++) {
                    if (on[i] in drop) continue
                    nt = split(od[i], tok, " ")
                    for (j = 1; j <= nt; j++) {
                        t = tok[j]
                        if (t ~ /:/ || t ~ /^!/) continue
                        sub(/[<>=].*/, "", t)
                        if (t in drop) { drop[on[i]] = 1; ch = 1; break }
                    }
                }
            } while (ch)
            nd = 0
            for (d in drop) nd++
            printf "%d %d %d %d\n", np + 0, nd, ph + 0, probe + 0
            for (d in drop) print d
        }
    ' "$1" "$2"
}

# rom 基线覆盖检查。参数: <rom_db> <upper_db> <rom_world>
# 输出: "<rom 有而 upper db 缺的包数> <rom world 版本钉死不满足的条数>"
# 2026-10 设备实测（r0-63c7fdb -> r0-f9b0ce7）: kernel 版本未变、无死记录，
# 但新镜像换了 base-files 版本并新增 ucode-mod-math；只看 kernel 会判"健康"，
# 结果 apk add/fix 全部 breaks。此处把「新镜像基线是否被 overlay db 覆盖」
# 也纳入判据：缺包或 world 钉死版本对不上都要重建。
rom_baseline_scan() {
    # 注意: 不能用 getline < world —— 本 awk 用 RS="" 分段解析 db，
    # getline 会继承该 RS，把整个 world（无空行）读成一条记录。
    # 故先按行拼成 '|' 分隔串传入（包名/版本不含 '|'）。
    local wl
    wl=$(tr '\n' '|' < "$3" 2>/dev/null)
    awk -v wl="$wl" '
        BEGIN { RS="" }
        function pkg_of(b,   n, a, i) {
            n = split(b, a, "\n")
            for (i = 1; i <= n; i++)
                if (substr(a[i], 1, 2) == "P:") return substr(a[i], 3)
            return ""
        }
        function ver_of(b,   n, a, i) {
            n = split(b, a, "\n")
            for (i = 1; i <= n; i++)
                if (substr(a[i], 1, 2) == "V:") return substr(a[i], 3)
            return ""
        }
        NR == FNR { p = pkg_of($0); if (p != "") rom_v[p] = ver_of($0); next }
        { p = pkg_of($0); if (p != "") { have[p] = 1; have_v[p] = ver_of($0) } }
        END {
            miss = 0
            for (p in rom_v) if (!(p in have)) miss++
            pin = 0
            nw = split(wl, w, "|")
            for (i = 1; i <= nw; i++) {
                line = w[i]
                if (line == "") continue
                eq = index(line, "=")
                if (eq < 2) continue
                n = substr(line, 1, eq - 1); v = substr(line, eq + 1)
                if (n ~ /[<>~]/) continue   # apk pin operator 令牌，跳过
                if (!(n in have_v) || have_v[n] != v) pin++
            }
            printf "%d %d\n", miss, pin
        }
    ' "$1" "$2"
}

sync_apk_db() {
    local upper_db="/overlay/upper/lib/apk/db/installed"
    local rom_db="/rom/lib/apk/db/installed"
    local rom_world="/rom/etc/apk/world"

    [ -f "$upper_db" ] && [ -f "$rom_db" ] || return 0

    local kv_upper kv_rom
    kv_upper=$(db_kernel_v "$upper_db")
    kv_rom=$(db_kernel_v "$rom_db")

    # 死记录扫描（同时给出 overlay 独有数；首行第3/4字段=幻影数/探针ok）
    local scan n_ov n_drop drop_names n_ph probe_ok
    scan=$(stale_scan "$rom_db" "$upper_db")
    n_ov=$(echo "$scan" | head -1 | awk '{print $1}')
    n_drop=$(echo "$scan" | head -1 | awk '{print $2}')
    n_ph=$(echo "$scan" | head -1 | awk '{print $3+0}')
    probe_ok=$(echo "$scan" | head -1 | awk '{print $4+0}')
    drop_names=$(echo "$scan" | tail -n +2)
    if [ "${probe_ok:-1}" -eq 0 ]; then
        log "phantom probe FAILED (awk system 异常), 本轮跳过幻影剔除，仅按 stale 规则"
    fi

    # rom 基线覆盖检查（新镜像的包 / 版本钉死是否已被 overlay db 覆盖）
    local baseline n_miss n_pin
    baseline=$(rom_baseline_scan "$rom_db" "$upper_db" "$rom_world")
    n_miss=$(echo "$baseline" | awk '{print $1}')
    n_pin=$(echo "$baseline" | awk '{print $2}')
    n_miss=${n_miss:-0}
    n_pin=${n_pin:-0}

    # kernel 一致 + 无死记录 + rom 基线全覆盖 = 库健康，不动
    if [ -n "$kv_rom" ] && [ "$kv_upper" = "$kv_rom" ] && \
       [ "$n_drop" -eq 0 ] && [ "$n_miss" -eq 0 ] && [ "$n_pin" -eq 0 ]; then
        return 0
    fi

    log "apk db: overlay kernel=$kv_upper rom kernel=$kv_rom stale+phantom=$n_drop (phantom=$n_ph) missing=$n_miss pin_mismatch=$n_pin -> rebuild"

    local n_rom n_upper n_keep
    n_rom=$(grep -c '^P:' "$rom_db")
    n_upper=$(grep -c '^P:' "$upper_db")
    n_keep=$((n_ov - n_drop))

    # apk db 块结构（2026-10 设备实测）: C:校验 → P:包名 → 字段 → 空行，
    # 文件以 \n\n 结尾；因此必须按空行分段（RS=""）整块处理 —— 以 P: 为块首
    # 的旧实现会把 C: 行错位（计数翻倍/丢 C:/孤儿 C: 块），DRYRUN 实测已证伪。
    if [ -n "$DRYRUN" ]; then
        log "DRYRUN: would rebuild db = rom($n_rom) + keep($n_keep = overlay-only $n_ov - drop $n_drop [phantom $n_ph]), backup of $n_upper-pkg db (missing=$n_miss pin_mismatch=$n_pin)"
        [ -n "$drop_names" ] && log "DRYRUN: would drop stale/phantom: $(echo $drop_names)"
        return 0
    fi

    local bak new
    bak="${upper_db}.bak.$(date +%Y%m%d%H%M%S)"
    cp -f "$upper_db" "$bak"
    new="${upper_db}.new"

    # 新库 = 整个 rom db，追加 overlay 独有包（整块原样含 C: 行）
    cp -f "$rom_db" "$new"
    # 归一: 确保 rom 底以空行结尾，否则与首个人工追加块粘连
    local nl
    nl=$(tail -c2 "$new" | tr -dc '\n' | wc -c)
    if [ "$nl" -lt 2 ]; then
        if [ "$nl" -eq 1 ]; then printf '\n' >> "$new"; else printf '\n\n' >> "$new"; fi
    fi
    # 追加 overlay 独有包（整块原样含 C: 行），剔除死记录 skip 列表
    awk -v skip="$drop_names" '
        BEGIN {
            RS=""; ORS=""
            ns = split(skip, sk, " ")
            for (i = 1; i <= ns; i++) if (sk[i] != "") dropset[sk[i]] = 1
        }
        function pkg_of(b,   n, a, i) {
            n = split(b, a, "\n")
            for (i = 1; i <= n; i++)
                if (substr(a[i], 1, 2) == "P:") return substr(a[i], 3)
            return ""
        }
        NR == FNR {
            if ($0 != "") { p = pkg_of($0); if (p != "") seen[p] = 1 }
            next
        }
        {
            if ($0 == "") next
            p = pkg_of($0)
            if (p != "" && !(p in seen) && !(p in dropset)) printf "%s\n\n", $0
        }
    ' "$rom_db" "$upper_db" >> "$new"

    # 校验（四重，任一不过则放弃重建、保留原库）:
    #   1) 含 kernel 记录
    #   2) P: 行数 == 精确期望 rom + (overlay独有 - 死记录)
    #   3) P: 行数 == C: 行数（丢 C:/孤儿 C: 都会让两者不等）
    #   4) 空行分段块数 == P: 行数（粘连合并会使块数偏少）
    local p_cnt c_cnt n_blocks n_expect
    n_expect=$((n_rom + n_ov - n_drop))
    p_cnt=$(grep -c '^P:' "$new")
    c_cnt=$(grep -c '^C:' "$new")
    n_blocks=$(awk 'BEGIN{RS=""} $0!=""{c++} END{print c+0}' "$new")
    if grep -q '^P:kernel$' "$new" && \
       [ "$p_cnt" -eq "$n_expect" ] && \
       [ "$p_cnt" -eq "$c_cnt" ] && \
       [ "$n_blocks" -eq "$p_cnt" ]; then
        chmod 644 "$new"
        mv -f "$new" "$upper_db"
        log "apk db rebuilt: $p_cnt pkgs (was $n_upper, rom $n_rom, dropped $n_drop stale); backup: $bak"
    else
        rm -f "$new"
        log "apk db rebuild validation FAILED (p=$p_cnt expect=$n_expect c=$c_cnt blocks=$n_blocks), keep original (backup: $bak)"
        return 1
    fi
}

# ---------- C) apk world 同步 ----------
# 2026-10 设备实证: /etc/apk/world 是 conffile，sysupgrade 保留 overlay 时
# 旧镜像 world（钉死 kernel=6.18.44~ / base-files=1~4b85d5d）遮蔽 rom world
# → apk add/fix 报 "breaks: world[...]" 全部失败。db 重建(B)不碰 world，
# 必须独立同步。
# 注: 行尾 `包名><Q1...=`（如 luci-app-openclash><Q1...）并非损坏 —— 那是 apk
#     本地装包时写的合法 pin operator（apk 可正常解析，实测 rc=0）；本函数以
#     纯包名构造候选 world，开机会把此类 token 规范化掉。
# 规则: new world = rom world（正确钉死）∪ overlay 独有包名（db 差集，纯包名，
# 构造上不可能引入 rom 之外的钉死项）；与现状一致则不写不备份。
sync_apk_world() {
    local upper_world="/overlay/upper/etc/apk/world"
    local rom_world="/rom/etc/apk/world"
    local upper_db="/overlay/upper/lib/apk/db/installed"
    local rom_db="/rom/lib/apk/db/installed"

    [ -f "$rom_world" ] || return 0
    [ -f "$upper_world" ] || return 0   # 无 overlay world = 合并视图即 rom（健康）
    [ -f "$upper_db" ] && [ -f "$rom_db" ] || return 0

    # overlay 独有包名（与 B 段同款段落 awk，设备实测验证过；P: 行不含版本）
    local overlay_only
    overlay_only=$(awk '
        BEGIN { RS="" }
        function pkg_of(b,   n, a, i) {
            n = split(b, a, "\n")
            for (i = 1; i <= n; i++)
                if (substr(a[i], 1, 2) == "P:") return substr(a[i], 3)
            return ""
        }
        NR == FNR {
            if ($0 != "") { p = pkg_of($0); if (p != "") seen[p] = 1 }
            next
        }
        {
            if ($0 == "") next
            p = pkg_of($0)
            if (p != "" && !(p in seen)) print p
        }
    ' "$rom_db" "$upper_db")

    # 剔除死记录，与 B 段口径一致（DRYRUN 时 db 未重建，实跑时 db 已先重建
    # → 本过滤幂等为空；db 重建若校验失败被放弃，world 也不会要求死 kmod）
    local drop_s kept_only
    drop_s=$(stale_scan "$rom_db" "$upper_db" | tail -n +2)
    if [ -n "$drop_s" ]; then
        kept_only=""
        for p in $overlay_only; do
            echo "$drop_s" | grep -qxF "$p" || kept_only="$kept_only $p"
        done
        overlay_only=$kept_only
    fi

    local n_rom_w n_add p
    n_rom_w=$(wc -l < "$rom_world")
    n_add=0
    for p in $overlay_only; do
        grep -qxF "$p" "$rom_world" || n_add=$((n_add + 1))
    done

    if [ -n "$DRYRUN" ]; then
        log "DRYRUN: would sync world = rom($n_rom_w) + overlay-only-add($n_add) lines; current upper=$(wc -l < "$upper_world")"
        return 0
    fi

    local new
    new="${upper_world}.new"
    cp -f "$rom_world" "$new"
    for p in $overlay_only; do
        grep -qxF "$p" "$new" || printf '%s\n' "$p" >> "$new"
    done

    # 无变更 → 不写不备份（后续开机静默）
    if cmp -s "$new" "$upper_world"; then
        rm -f "$new"
        return 0
    fi

    # 校验（三重，任一不过则放弃、保留原 world）:
    #   1) 钉死项(kernel/base-files/libc)集合与 rom 完全一致（构造上只来自 rom，再验一次）
    #   2) 候选行不含 apk operator token(><)（候选由纯包名构造，构造上恒真，
    #      此处为防御性校验）
    #   3) overlay 独有包名全部在
    local pin_rom pin_new bad_tok=0 miss=0
    pin_rom=$(grep -E '^(kernel|base-files|libc)=' "$rom_world" | sort)
    pin_new=$(grep -E '^(kernel|base-files|libc)=' "$new" | sort)
    grep -q '><' "$new" && bad_tok=1
    for p in $overlay_only; do
        grep -qxF "$p" "$new" || miss=$((miss + 1))
    done
    if [ "$pin_rom" = "$pin_new" ] && [ "$bad_tok" -eq 0 ] && [ "$miss" -eq 0 ]; then
        local bak
        bak="${upper_world}.bak.$(date +%Y%m%d%H%M%S)"
        cp -f "$upper_world" "$bak"
        chmod 644 "$new"
        mv -f "$new" "$upper_world"
        log "world synced: $(wc -l < "$upper_world") lines (was $(wc -l < "$bak")); backup: $bak"
    else
        rm -f "$new"
        log "world sync validation FAILED (bad_tok=$bad_tok missing=$miss), keep original"
        return 1
    fi
}

apply() {
    if [ -z "$DRYRUN" ]; then
        # 开机分隔行: rev 取 /rom 版本（实测 /rom/etc/openwrt_version = r0-f9b0ce7），
        # uptime 回退即新一次开机 —— DRYRUN 不落盘（部署前验证保持零副作用）
        report "--- start rev=$(cat /rom/etc/openwrt_version 2>/dev/null || echo unknown) ---"
    fi
    prune_legacy
    sync_managed
    sync_apk_db
    sync_apk_world
    if [ -z "$DRYRUN" ]; then
        # 直写 /overlay/upper 绕过了 overlayfs 合并路径，已缓存的 dentry 不会
        # 自动失效（2026-10 设备实测: rebuild 后合并视图 /lib/apk/db/installed
        # 仍停在旧 inode/旧内容，apk 读到 521 条旧库；drop_caches 后才刷新为
        # 新库 524 条）。sync+drop_caches 确保合并视图立即一致。
        sync
        echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
        # 汇总行恒写: actions=0 即健康空跑（与「脚本没跑」可区分——后者无 start 行）
        report "run done: actions=$ACTIONS (0=无漂移)"
    fi
    return 0
}

start() {
    apply
}

boot() {
    apply
}
