#!/bin/sh /etc/rc.common
######################################################################
# vim: set ft=sh
# nss_tune - NSS n2h/pbuf 调优（纯有线 / nowifi 场景）
#
# 背景:
#   VIKINGYFY 官方 NSS pbuf 调优脚本 qca-nss-pbuf.init 只在
#   CONFIG_ATH11K_NSS_SUPPORT 定义时才由 mac80211 包安装
#   （package/kernel/mac80211/Makefile: ifdef CONFIG_ATH11K_NSS_SUPPORT），
#   且其 start() 首行即被 ath11k 运行时检查挡住：
#       ath11k_runtime_available || { ...skipping... return 0; }
#   对 nowifi 设备（无 ieee80211 / 无线模块未加载）根本不会执行。
#   真机实测 dev.nss.n2hcfg.* 全为默认值，NSS 未按 2GB 内存调优。
#
# 机制:
#   在 qca-nss-drv (START=28) 之后（本脚本 START=29）写入官方
#   apply_nss_config 的
#   内存分档值。extra_pbuf_core0 仅在当前为 0（未分配）时设置。
#
# 取值来源: VIKINGYFY package/kernel/mac80211/files/qca-nss-pbuf.init
#           apply_nss_config() 的内存分档（>512MB 档）。
# 移除条件: 上游让 qca-nss-pbuf.init 脱离 ath11k 检查、对纯有线也生效后。
######################################################################

START=29

PROG=nss_tune

# NSS 频率档位强制为 high
#   背景: 原实现放在一次性 uci-defaults 998_set_nss_freq，会被 overlay "白化"
#   （删除标记）遮蔽 → 永不重跑（2026-10-17 实证: 设备长期停在 mid=748.8MHz）。
#   放到运行期 init（每次开机执行）即可免疫该遮蔽。
#   本函数只改 uci 配置；硬件频率由 nss_freq 服务（START=95）读取后应用，
#   因此不依赖 NSS 驱动此刻是否已就绪。
# 移除条件: 若上游/rom 默认 config 已保证档位、或 998 不再会被遮蔽。
enforce_nss_freq_level() {
    uci -q get nss_freq.settings >/dev/null 2>&1 || return 0

    [ "$(uci -q get nss_freq.settings.level)" = "high" ] && return 0

    uci -q set nss_freq.settings.level='high' || return 0
    uci -q commit nss_freq || return 0
    logger -t "$PROG" "nss_freq level 强制为 high"

    # 立即应用（此时 NSS 未就绪则静默失败，仍由 nss_freq 服务 S95 应用）
    [ -x /etc/init.d/nss_freq ] && /etc/init.d/nss_freq restart >/dev/null 2>&1
    return 0
}

# sysctl 表：每行 "<key> <value>"；__HW__/__RPS__ 由调用方计算后传入。
# 顺序即应用顺序，改动请保持"基础项 -> extra_pbuf -> 分档项"的既有次序。
NSS_SYSCTLS_BASE="
dev.nss.clock.auto_scale 0
dev.nss.n2hcfg.n2h_queue_limit_core0 2048
dev.nss.n2hcfg.n2h_queue_limit_core1 2048
"

NSS_SYSCTLS_TIER="
dev.nss.n2hcfg.n2h_high_water_core0 __HW__
dev.nss.rps.hash_bitmap __RPS__
"

# $1=表内容 $2=__HW__ 值 $3=__RPS__ 值（空则跳过该行）
apply_sysctl_table() {
    local tbl="$1" hw_v="$2" rps_v="$3" key val
    while read -r key val; do
        [ -n "$key" ] || continue
        case "$val" in
            __HW__)  val="$hw_v" ;;
            __RPS__) [ -n "$rps_v" ] || continue; val="$rps_v" ;;
        esac
        sysctl -qw "$key=$val" 2>/dev/null
    done <<EOF
$tbl
EOF
}

apply_nss_tune() {
    enforce_nss_freq_level

    local t=8

    # 等待 NSS n2hcfg sysctl 就绪（qca-nss-drv 在 START=28 加载）
    while [ "$t" -gt 0 ]; do
        [ -w /proc/sys/dev/nss/n2hcfg/n2h_queue_limit_core0 ] && break
        sleep 1
        t=$((t - 1))
    done

    [ -w /proc/sys/dev/nss/n2hcfg/n2h_queue_limit_core0 ] || {
        logger -t "$PROG" "NSS n2hcfg sysctl 未就绪，跳过调优"
        return 0
    }

    # 基础项：关闭自动调频（固定频率，降低延迟抖动）+ n2h 队列上限（官方值）
    apply_sysctl_table "$NSS_SYSCTLS_BASE" "" ""

    # 按 MemTotal 分档（对齐官方 apply_pbuf_profile）
    local mem ep hw
    mem=$(awk '/MemTotal/{print $2}' /proc/meminfo)
    if [ "${mem:-0}" -gt 512000 ]; then
        ep=10000000
        hw=65536
    elif [ "${mem:-0}" -gt 256000 ]; then
        ep=8000000
        hw=32768
    else
        ep=4000000
        hw=16384
    fi

    # extra_pbuf_core0 只能在未分配(=0)时设置，分配后不可改
    local cur
    cur=$(sysctl -n dev.nss.n2hcfg.extra_pbuf_core0 2>/dev/null)
    if [ "${cur:-0}" = "0" ]; then
        sysctl -qw "dev.nss.n2hcfg.extra_pbuf_core0=$ep" && \
            logger -t "$PROG" "extra_pbuf_core0=$ep (mem=${mem}kB)"
    else
        logger -t "$PROG" "extra_pbuf_core0 已分配($cur)，跳过"
    fi
    # 注: 写入值 ≠ sysctl 读回值属正常 —— 驱动按请求向上取整后实际分配。
    #   2026-10-21 真机: 本脚本写 10000000 → 内核日志
    #   "qca-nss ... Additional pbufs of size 10002432 got added to NSS"
    #   → sysctl 读回 10002432（+0.02%）。体检勿把该差值当配置漂移。

    # 分档项 + RPS hash bitmap（对齐官方 hash_bitmap=(1<<ncpu)-1）
    local ncpu rps=""
    ncpu=$(grep -c '^processor' /proc/cpuinfo 2>/dev/null)
    [ -n "$ncpu" ] && [ "$ncpu" -gt 0 ] && rps=$(((1 << ncpu) - 1))
    apply_sysctl_table "$NSS_SYSCTLS_TIER" "$hw" "$rps"

    logger -t "$PROG" "NSS n2h/pbuf 调优完成 (ep=$ep hw=$hw queue=2048)"
}

start() {
    apply_nss_tune
}

boot() {
    apply_nss_tune
}
