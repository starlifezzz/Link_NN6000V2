#!/bin/sh
######################################################################
# vim: set ft=sh
# 996_fix_luci_homepage - LuCI 首页遗留修复
#
# 已废弃:
#   - 清缓存 + 重启 uwsgi：uwsgi START 已改为 93（quickstart S92 之后），
#     路由缓存竞态从源头解决（见 system.sh fix_uwsgi_start_priority）。
#
# 保留:
#   1) 创建 wwan.js stub（luci-proto-wwan 未完整安装时消除404 JS报错）
#   2) 禁用 uhttpd 自启动（S50 先于 nginx S80，抢占80端口）
######################################################################

START=96

# 1) 创建 wwan.js stub，消除404 JS报错
WWAN_JS="/www/luci-static/resources/protocol/wwan.js"
if [ ! -f "$WWAN_JS" ]; then
    mkdir -p "$(dirname "$WWAN_JS")"
    printf "'use strict';'require network';return network.registerProtocol('wwan',{getI18n:function(){return _('WWAN');}});" > "$WWAN_JS"
fi

# 2) 禁用 uhttpd 自启动
#    uhttpd 作为原生包安装(CONFIG_PACKAGE_uhttpd=y)用于 LuCI 密码哈希(uhttpd -m)，
#    但其 init 脚本(S50)先于 nginx(S80)执行，会抢占 80 端口导致 nginx 启动失败。
#    禁用 uhttpd 自启动，只保留二进制供密码哈希调用。
if [ -f /etc/init.d/uhttpd ]; then
    /etc/init.d/uhttpd disable
fi

exit 0
