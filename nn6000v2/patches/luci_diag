#!/bin/sh
######################################################################
# luci_diag v3 - LuCI 登录故障诊断（测完整 HTTP 链路）
# 用法: luci_diag
######################################################################

echo "============================================"
echo "  LuCI 登录故障诊断 v3"
echo "  $(date)"
echo "============================================"
echo ""

# ---- 1. rpcd 配置 ----
echo ">>> 1. rpcd 配置"
cat /etc/config/rpcd 2>/dev/null || echo "[ERROR] /etc/config/rpcd 不存在"
echo ""

# ---- 2. rpcd 密码原始值 ----
echo ">>> 2. rpcd 密码原始值 (od hex dump)"
if uci -q get rpcd.@login[0].password >/dev/null 2>&1; then
    RAW=$(uci -q get rpcd.@login[0].password)
    echo "uci get 返回: [$RAW]"
    echo -n "hex: "
    echo -n "$RAW" | od -A n -t x1 | tr -s ' '
    echo -n "字节数: "
    echo -n "$RAW" | wc -c | tr -d ' '
    echo ""
else
    echo "uci get rpcd.@login[0].password 失败（字段不存在）"
    echo "这意味着 rpcd 配置里没有 password 字段"
fi
echo ""

# ---- 3. 关键进程 ----
echo ">>> 3. 关键进程"
for p in rpcd nginx uwsgi; do
    pid=$(pgrep -x "$p" 2>/dev/null | head -1)
    if [ -n "$pid" ]; then
        echo "$p: PID=$pid ✅"
    else
        echo "$p: ❌ 未运行"
    fi
done
echo ""

# ---- 4. nginx 配置 ----
echo ">>> 4. nginx LuCI 配置"
if [ -f /etc/nginx/conf.d/luci.locations ]; then
    cat /etc/nginx/conf.d/luci.locations
elif [ -f /etc/nginx/uwsgi Location ]; then
    cat /etc/nginx/uwsgi\ Location
else
    echo "尝试查找 luci nginx 配置..."
    grep -rl "luci\|uwsgi" /etc/nginx/ 2>/dev/null | head -5
    for f in $(grep -rl "luci\|uwsgi" /etc/nginx/ 2>/dev/null | head -5); do
        echo "--- $f ---"
        cat "$f"
        echo ""
    done
fi
echo ""

# ---- 5. uwsgi luci 配置 ----
echo ">>> 5. uwsgi luci 配置"
cat /etc/uwsgi/vassals/luci-webui.ini 2>/dev/null || echo "luci-webui.ini 不存在"
echo ""

# ---- 6. uwsgi socket 状态 ----
echo ">>> 6. uwsgi socket 状态"
ls -la /var/run/luci-webui.socket 2>/dev/null || echo "/var/run/luci-webui.socket 不存在"
ls -la /var/run/uwsgi/ 2>/dev/null || echo "/var/run/uwsgi/ 不存在"
echo ""

# ---- 7. LuCGI 端点测试 (curl 127.0.0.1) ----
echo ">>> 7. LuCGI 端点测试"
echo "--- 测试 /cgi-bin/luci (未认证) ---"
RESP=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1/cgi-bin/luci 2>/dev/null)
echo "HTTP 状态码: $RESP"
echo ""

echo "--- 测试 /cgi-bin/luci (带空密码登录) ---"
RESP=$(curl -s -D- -o /tmp/luci_login_body.html \
    -X POST http://127.0.0.1/cgi-bin/luci \
    -d "luci_username=root&luci_password=" 2>/dev/null)
echo "响应头:"
echo "$RESP" | head -20
echo ""
echo "响应体前500字符:"
head -c 500 /tmp/luci_login_body.html 2>/dev/null
echo ""
echo ""

echo "--- 测试 /cgi-bin/luci (带密码 root 登录) ---"
RESP=$(curl -s -D- -o /tmp/luci_login_body2.html \
    -X POST http://10.0.0.1/cgi-bin/luci \
    -d "luci_username=root&luci_password=root" 2>/dev/null)
echo "响应头:"
echo "$RESP" | head -20
echo ""
echo "响应体前500字符:"
head -c 500 /tmp/luci_login_body2.html 2>/dev/null
echo ""
echo ""

# ---- 8. 通过 uwsgi socket 直接测试 ----
echo ">>> 8. uwsgi socket 直接测试"
if [ -S /var/run/luci-webui.socket ]; then
    echo "--- uwsgi 协议直接连 /cgi-bin/luci ---"
    # 用 uwsgi 协议发一个 GET /cgi-bin/luci
    printf '\x00\x01\x00\x05\x00\x0dSCRIPT_NAME\x00\x09/cgi-bin\x00\x0bPATH_INFO\x00\x05/luci\x00\x0dREQUEST_METHOD\x00\x03GET\x00\x0fSERVER_PROTOCOL\x00\x08HTTP/1.0\x00\x0bSERVER_NAME\x00\x09127.0.0.1\x00\x0cSERVER_PORT\x00\x0580\x00\x0cQUERY_STRING\x00\x00\x09SERVER_SOFTWARE\x00\x02uwsgi\x00\x10uwsgi.version\x00\x0201\x00\x0bREMOTE_ADDR\x00\x09127.0.0.1\x00\x0cREMOTE_PORT\x00\x050000\x00\x0cDOCUMENT_ROOT\x00\x01/\x00\x0bREQUEST_URI\x00\x0b/cgi-bin/luci\x00\x08HTTP_HOST\x00\x09127.0.0.1\x00' | timeout 3 socat - UNIX-CONNECT:/var/run/luci-webui.socket 2>/dev/null | head -30
    echo ""
else
    echo "uwsgi socket 不存在，跳过"
fi
echo ""

# ---- 9. dispatcher.uc 检查 ----
echo ">>> 9. dispatcher.uc 关键文件"
ls -la /usr/lib/lua/luci/controller/ 2>/dev/null | head -10
ls -la /usr/lib/lua/luci/dispatcher.lua 2>/dev/null
ls -la /www/cgi-bin/luci 2>/dev/null
ls -la /www/cgi-bin/luci-* 2>/dev/null
echo ""

# ---- 10. LuCI session 文件 ----
echo ">>> 10. LuCI session 文件"
ls -la /tmp/luci-* 2>/dev/null || echo "/tmp/luci-* 不存在"
ls -la /tmp/sessions/ 2>/dev/null || echo "/tmp/sessions/ 不存在"
echo ""

# ---- 11. 日志中 LuCI 相关 ----
echo ">>> 11. 最近 LuCI/rpcd/nginx/uwsgi 日志"
logread 2>/dev/null | grep -iE '(luci|rpcd|uwsgi|nginx|session|login|auth)' | tail -30
echo ""

# ---- 12. overlay 写入 + uci commit ----
echo ">>> 12. overlay 写入测试"
if touch /etc/_diag_test 2>/dev/null; then
    rm -f /etc/_diag_test
    echo "overlay 写入: ✅"
else
    echo "overlay 写入: ❌"
fi
echo "uci commit 测试:"
uci set _diag.test=1 2>/dev/null
if uci commit _diag 2>/dev/null; then
    echo "uci commit: ✅"
else
    echo "uci commit: ❌"
    # 显示详细错误
    uci commit _diag 2>&1
fi
uci delete _diag 2>/dev/null
echo ""

echo "============================================"
echo "  诊断完成 - 请全部复制发出来"
echo "============================================"
