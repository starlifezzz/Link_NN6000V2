#!/bin/sh /etc/rc.common
######################################################################
# vim: set ft=sh
# fix_luci_ucode - 启动时用 /rom 固件自带版本修复被 overlay/备份
#                  遮蔽的 luci 核心 ucode 文件
#
# 背景:
#   istore 全量备份会把旧固件 overlay 中的 luci 核心 ucode 文件
#   （/usr/share/rpcd/ucode/luci 及 luci.sys/version/zoneinfo 等模块）
#   原样带回，遮蔽 /rom 中新固件的自洽版本。典型症状：
#   旧 luci 脚本 import 的符号（如 init_action）在新 sys.uc 中不存在
#   → rpcd 加载 ucode 脚本报 "Module ... does not export 'init_action'"
#   → luci object 未注册 → LuCI 前端 luci/getFeatures RPC 报
#   -32000 Object not found → 系统信息/温度/负载/固件版本显示 ?。
#
# 机制:
#   每次开机（START=10，早于 rpcd 的 START=12）将 /rom 中固件自带的
#   版本强制覆盖回 overlay，确保 rpcd 扫描 ucode 目录前文件已就位。
#
# 注意:
#   不能用 rm（overlayfs 上 rm 会产生 whiteout 永久遮蔽 /rom 同名文件），
#   必须用 cp 直接覆盖（cp 会清除 whiteout 并写入正确内容）。
#   仅覆盖 luci-base 提供、随固件写入 /rom 的核心文件；不动
#   controller/template/dispatcher 等用户可定制部分，避免误伤。
######################################################################

START=10

PROG=fix_luci_ucode

# luci-base 提供、随固件写入 /rom 的核心 ucode 文件
LUCI_FILES="
/usr/share/rpcd/ucode/luci
/usr/share/ucode/luci/sys.uc
/usr/share/ucode/luci/version.uc
/usr/share/ucode/luci/zoneinfo.uc
/usr/lib/ucode/luci/core.so
"

boot() {
    local f
    for f in $LUCI_FILES; do
        if [ -f "/rom$f" ]; then
            if [ ! -e "$f" ] || ! cmp -s "/rom$f" "$f"; then
                mkdir -p "$(dirname "$f")"
                if cp -f "/rom$f" "$f" 2>/dev/null; then
                    logger -t "$PROG" "restored $f from /rom (overlay version stale or missing)"
                fi
            fi
        fi
    done
}
