#!/bin/sh
######################################################################
# vim: set ft=sh
# 999_harden_firewall - 首次启动应用防火墙安全加固
#
# 加固项:
#   1) fullcone NAT 关闭
#   2) docker zone forward 收紧为 REJECT
#   3) 删除 WAN 侧 linkease(8897) 放行规则
#   4) dnsmasq 仅监听 lan（避免绑定 WAN 地址提供 DNS）
#   5) dropbear 仅绑定 lan 网络（Interface=lan 逻辑网络名，非 br-lan）
#   6) rpcd.@login 保留但确保密码非默认（首次启动时若为默认则改为强随机密码）
#
# 注意: UPnP 不在本脚本处理范围内（用户要求长期启用，不自动禁用）。
#
# 全部操作均带存在性判断，缺 section/包时静默跳过。
######################################################################

START=10

PROG=harden_firewall

# 1) fullcone NAT 关闭
if uci -q get firewall.@defaults[0] >/dev/null 2>&1; then
    uci set firewall.@defaults[0].fullcone='0'
fi

# 2) docker zone forward 收紧为 REJECT
if uci -q get firewall.docker >/dev/null 2>&1; then
    uci set firewall.docker.forward='REJECT'
fi

# 3) 删除 WAN 侧 linkease(8897) 放行规则
if uci -q get firewall.linkease >/dev/null 2>&1; then
    uci -q delete firewall.linkease
fi

# 4) dnsmasq 仅监听 lan
if uci -q get dhcp.@dnsmasq[0] >/dev/null 2>&1; then
    uci -q delete dhcp.@dnsmasq[0].interface 2>/dev/null
    uci add_list dhcp.@dnsmasq[0].interface='lan'
fi

# 5) dropbear 仅绑定 lan 网络（Interface=lan 逻辑网络名，非 br-lan）
if uci -q get dropbear.main >/dev/null 2>&1; then
    uci set dropbear.main.Interface='lan'
fi

# 6) rpcd.@login 保留但确保密码非默认（首次启动时若为默认则改为强随机密码）
if uci -q get rpcd.@login[0] >/dev/null 2>&1; then
    if [ "$(uci -q get rpcd.@login[0].password)" = "\$p\$root" ]; then
        RAND_PASS=$(head -c 16 /dev/urandom | base64 | tr -d '\n' | cut -c1-16)
        uci set rpcd.@login[0].password="\$p\$${RAND_PASS}"
    fi
else
    # 如果不存在则创建一个强密码
    uci add rpcd login
    uci set rpcd.@login[-1].username='root'
    RAND_PASS=$(head -c 16 /dev/urandom | base64 | tr -d '\n' | cut -c1-16)
    uci set rpcd.@login[-1].password="\$p\$${RAND_PASS}"
    uci add_list rpcd.@login[-1].read='*'
    uci add_list rpcd.@login[-1].write='*'
fi

uci commit firewall 2>/dev/null
uci commit dhcp 2>/dev/null
uci commit dropbear 2>/dev/null

exit 0
