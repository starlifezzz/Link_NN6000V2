# M2 收紧监听面（2026-10 深查项）:
#   原为 80/443 + [::] 通配监听 = 整个 LAN（含全部 IoT）可直达 LuCI 管理面。
#   fw4 已拒 WAN，但同网段 IoT 失陷即可打管理口 —— 改为只绑:
#     10.0.0.1  = LAN 网关地址（本仓库 update_default_lan_addr 固定该地址）
#     127.0.0.1 = 本机（luci_diag 等本机回环探测）
#   撤除 [::] IPv6 通配；如需 IPv6 LuCI 访问，自行加回对应 listen。
#   回滚: 恢复 listen '80' / '[::]:80' / '443 ssl default_server' 原值并 reload nginx。
config main 'global'
        option uci_enable 'true'

config server '_lan'
        list listen '10.0.0.1:443 ssl default_server'
        list listen '127.0.0.1:443 ssl default_server'
        option server_name '_lan'
        list include 'restrict_locally'
        list include 'conf.d/*.locations'
        option uci_manage_ssl 'self-signed'
        option ssl_certificate '/etc/nginx/conf.d/_lan.crt'
        option ssl_certificate_key '/etc/nginx/conf.d/_lan.key'
        option ssl_session_cache 'shared:SSL:32k'
        option ssl_session_timeout '64m'
        option access_log 'off; # logd openwrt'

# 2026-11-06 决定: 80 端口保持"可用 HTTP"，不沿用上游 _redirect2ssl 的 302 跳转。
#   原因: 本机 _lan.crt 为自签名证书且无 SAN（实测 subject=CN=OpenWrt，无
#         subjectAltName/BasicConstraints/KeyUsage），浏览器判定不安全上下文；
#         Zen 浏览器在该状态下不自动填充已保存密码（浏览器行为，属未验证项）。
#   说明: 无认证访问 /cgi-bin/luci/ 返回 403 + x-luci-login-required: yes，
#         那是 LuCI 的"未登录"标准响应（body 即登录页），不是 nginx 拒绝；
#         https 同路径未登录同样 403。两边行为一致。
#   范围: 仅 10.0.0.1 / 127.0.0.1，无 [::] 通配（沿用上面的收紧策略）。
#   回滚: 若需恢复 302 跳转，把本段换回:
#         config server '_redirect2ssl' + option return '302 https://$host$request_uri'
config server 'http_only'
        list listen '10.0.0.1:80'
        list listen '127.0.0.1:80'
        option server_name 'http_only'
        list include 'conf.d/*.locations'
        option access_log 'off; # logd openwrt'
