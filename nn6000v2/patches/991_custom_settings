#!/bin/sh
#===============================================================================
# 991_custom_settings - System Custom Settings
#
# 功能：首次启动时的设备级系统配置
#
# 说明：
#   - 网络调优 (conntrack/TCP/BBR/安全项) 已迁移至构建期文件
#     /etc/sysctl.d/zz-custom.conf (见 nn6000v2/patches/sysctl_custom.conf)
#     字典序在 qca-nss-ecm.conf 之后，START=11 自动覆盖，随 rootfs 在 sysupgrade 后保留。
#   - 本脚本保留 dropbear 访问限制解除（若上游默认配置出现 DirectInterface 限制时自动解除）
#     与 LAN IPv6 有状态 DHCPv6 配置（同步上游 6fe3759；每开机保持见 patches/system_tune）
#===============================================================================

#-------------------------------------------------------------------------------
# 配置参数
#-------------------------------------------------------------------------------
DROPBEAR_CONFIG="dropbear.main"

#-------------------------------------------------------------------------------
# 辅助函数：输出日志
#-------------------------------------------------------------------------------
log_info() {
    echo "[INFO] $*"
}

log_error() {
    echo "[ERROR] $*" >&2
}

#-------------------------------------------------------------------------------
# 解除 dropbear SSH 访问限制
#-------------------------------------------------------------------------------
configure_dropbear() {
    local config_section="$DROPBEAR_CONFIG"

    # 检查 dropbear 配置是否存在
    if ! uci show "$config_section" >/dev/null 2>&1; then
        log_error "dropbear 配置不存在，跳过"
        return 1
    fi

    # 检查是否存在 DirectInterface 限制
    if ! uci show "$config_section" | grep -q "DirectInterface"; then
        log_info "dropbear 未设置 DirectInterface 限制"
        return 0
    fi

    log_info "正在解除 dropbear DirectInterface 访问限制..."

    # 删除限制配置
    if uci delete "${config_section}.DirectInterface" 2>/dev/null; then
        # 提交更改
        if uci commit "$config_section" 2>/dev/null; then
            # 重启 dropbear 服务
            if /etc/init.d/dropbear restart >/dev/null 2>&1; then
                log_info "dropbear 访问限制已解除，服务已重启"
                return 0
            else
                log_error "重启 dropbear 服务失败"
                return 1
            fi
        else
            log_error "提交 dropbear 配置失败"
            return 1
        fi
    else
        log_error "删除 DirectInterface 配置失败"
        return 1
    fi
}

#-------------------------------------------------------------------------------
# 配置 IPv6 DHCPv6 有状态分配（同步上游 6fe3759）
#-------------------------------------------------------------------------------
configure_ipv6_dhcpv6() {
    log_info "正在配置 LAN IPv6 有状态 DHCPv6..."

    uci -q batch << 'EOF'
set dhcp.lan.dhcpv6='server'
set dhcp.lan.ra='server'
delete dhcp.lan.ra_flags
add_list dhcp.lan.ra_flags='managed-config'
add_list dhcp.lan.ra_flags='other-config'
commit dhcp
EOF

    if [ $? -eq 0 ]; then
        log_info "DHCPv6 有状态分配配置完成 (server + managed/other flags)"
        return 0
    else
        log_error "DHCPv6 配置失败"
        return 1
    fi
}

#-------------------------------------------------------------------------------
# 主函数
#-------------------------------------------------------------------------------
main() {
    log_info "开始应用自定义系统配置..."

    # 配置 dropbear
    configure_dropbear

    # IPv6 有状态 DHCPv6
    configure_ipv6_dhcpv6

    log_info "自定义配置应用完成"
}

# 执行主函数
main
