#!/bin/sh /etc/rc.common
######################################################################
# vim: set ft=sh
# fix_firewall_harden - 启动时检查并按需恢复防火墙安全加固
#
# 加固项（与 999_harden_firewall 一致）:
#   1) firewall fullcone 关闭
#   2) docker zone forward 收紧为 REJECT
#   3) 删除 WAN 侧 linkease(8897) 放行规则
#   4) dnsmasq 仅监听 lan
#   5) dropbear 仅绑定 lan (Interface=lan)
#
# 注意: UPnP 不在处理范围内（用户要求长期启用）。
# rpcd 密码由用户通过 LuCI 自主管理，本脚本不操作 rpcd。
######################################################################

START=18

PROG=fix_firewall_harden

apply_hardening() {
    local changed=0

    # 1) fullcone NAT 必须关闭
    if [ "$(uci -q get firewall.@defaults[0].fullcone)" = "1" ]; then
        uci set firewall.@defaults[0].fullcone='0'
        changed=1
        logger -t "$PROG" "fullcone NAT disabled"
    fi

    # 2) docker zone forward 不得为 ACCEPT
    if [ "$(uci -q get firewall.docker.forward)" = "ACCEPT" ]; then
        uci set firewall.docker.forward='REJECT'
        changed=1
        logger -t "$PROG" "docker zone forward ACCEPT -> REJECT"
    fi

    # 2) 删除 WAN 侧 linkease(8897) 放行规则
    if uci -q get firewall.linkease >/dev/null 2>&1; then
        uci -q delete firewall.linkease
        changed=1
        logger -t "$PROG" "removed WAN linkease(8897) rule"
    fi

    # 3) dnsmasq 必须限制在 lan
    if ! uci -q get dhcp.@dnsmasq[0].interface 2>/dev/null | grep -qw lan; then
        uci -q delete dhcp.@dnsmasq[0].interface 2>/dev/null
        uci add_list dhcp.@dnsmasq[0].interface='lan'
        changed=1
        logger -t "$PROG" "dnsmasq interface restricted to lan"
    fi

    # 4) dropbear 必须绑定 lan (逻辑网络名，非 br-lan)
    if [ -n "$(uci -q get dropbear.main)" ] && \
       [ "$(uci -q get dropbear.main.Interface)" != "lan" ]; then
        uci set dropbear.main.Interface='lan'
        changed=1
        logger -t "$PROG" "dropbear bound to lan via Interface=lan"
    fi

    [ "$changed" = "0" ] && return 0

    uci commit firewall 2>/dev/null
    uci commit dhcp 2>/dev/null
    uci commit dropbear 2>/dev/null

    logger -t "$PROG" "hardening re-applied (changed=$changed)"

    # 仅当服务已运行（非开机早期）才动服务；开机早期由各自的 START=19 读取新配置
    [ -e /var/run/fw4.state ] && /etc/init.d/firewall reload 2>/dev/null

    if pgrep -qx dnsmasq; then
        /etc/init.d/dnsmasq restart 2>/dev/null
    fi

    if pgrep -qx dropbear; then
        (sleep 1; /etc/init.d/dropbear restart >/dev/null 2>&1) &
    fi
}

start() {
    apply_hardening
}

boot() {
    apply_hardening
}
