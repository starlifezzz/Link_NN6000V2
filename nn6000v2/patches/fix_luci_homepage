#!/bin/sh /etc/rc.common
######################################################################
# vim: set ft=sh
# fix_luci_homepage - 每次启动清 LuCI 路由缓存 + 重启 uwsgi，
#                     修复 QuickStart/iStore 首页 404
#
# 背景:
#   uwsgi (S79) 构建 LuCI 路由缓存时，quickstart (S92) 尚未启动，
#   导致缓存中注册的是 redirect_fallback（→ /admin/status）。
#   仅在 uci-defaults 一次性清缓存不够，每次启动都需要清。
#
# 机制:
#   START=93（quickstart S92 之后），每次开机：
#   1) 创建 wwan.js stub（幂等，防 404）
#   2) 清除 luci-indexcache（强制 uwsgi 重建路由）
#   3) 重启 uwsgi（在 quickstart 已运行的状态下重建缓存）
#   4) 禁用 uhttpd 自启动（防抢占 nginx 80 端口）
#
# 来源: 本仓库构建，针对 VIKINGYFY/immortalwrt LuCI master
######################################################################

START=93

PROG=fix_luci_homepage

boot() {
    # 1) 创建 wwan.js stub，消除404 JS报错
    local WWAN_JS="/www/luci-static/resources/protocol/wwan.js"
    if [ ! -f "$WWAN_JS" ]; then
        mkdir -p "$(dirname "$WWAN_JS")"
        printf "'use strict';'require network';return network.registerProtocol('wwan',{getI18n:function(){return _('WWAN');}});" > "$WWAN_JS"
        logger -t "$PROG" "created wwan.js stub"
    fi

    # 2) 清除 LuCI dispatcher 路由缓存，强制重建
    rm -f /tmp/luci-indexcache*

    # 3) 重启 uwsgi，让路由表在 quickstart 已运行的状态下重新生成
    if [ -f /etc/init.d/uwsgi ]; then
        /etc/init.d/uwsgi restart >/dev/null 2>&1
        logger -t "$PROG" "uwsgi restarted, route cache rebuilt"
    fi

    # 4) 禁用 uhttpd 自启动
    #    uhttpd 作为原生包(CONFIG_PACKAGE_uhttpd=y)用于 LuCI 密码哈希(uhttpd -m)，
    #    但其 init 脚本(S50)先于 nginx(S80)执行，会抢占 80 端口导致 nginx 启动失败。
    if [ -f /etc/init.d/uhttpd ]; then
        /etc/init.d/uhttpd disable
    fi
}
