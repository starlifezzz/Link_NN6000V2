#!/bin/sh /etc/rc.common
######################################################################
# vim: set ft=sh
# system_tune - 系统级收尾清理/调优（每次开机检查，幂等）
#
# 处理项:
#   1) ext4 挂载加 errors=remount-ro
#      /overlay 与 /mnt/data_sda2 若未显式声明（ext4 默认虽为
#      remount-ro，这里显式化），改为 remount-ro：ext4 检测到错误时
#      转只读，保护数据完整性。
#      同时校验 /proc/mounts，如尚未生效则立即 remount（每次开机）。
#   2) 保持 LAN IPv6 有状态 DHCPv6（同步上游 6fe3759，原 custom_task boot 段）
#
# 已移除:
#   - rpcd 密码管理（已回滚）：用户通过 LuCI 自主管理密码，
#     system_tune 不再强制覆盖，避免每次开机覆盖用户在 LuCI 设置的密码。
#
# 明确不处理（已核实）:
#   - /etc/modules.conf 的 `options ecm front_end_selection=`：
#     由 qca-nss-ecm init 维护的有效参数，不可清理
#   - USB 写缓存：SanDisk Cruzer Blade 固件不支持切换，
#     恒为 write through（该盘 discard_max_bytes 也为 0，不支持 TRIM）。
#
# 时序: START=19（在 fstab/block-mount 的 S11 之后）
######################################################################

START=19

PROG=system_tune

apply() {
    local fstab_changed=0 sec target opts m

    # 1) ext4 挂载加 errors=remount-ro
    for sec in $(uci show fstab 2>/dev/null | sed -n 's/^fstab\.\(.*\)=mount$/\1/p'); do
        target=$(uci -q get "fstab.$sec.target")
        case "$target" in
            /overlay|/mnt/data_sda2)
                opts=$(uci -q get "fstab.$sec.options")
                case ",${opts}," in
                    *,errors=remount-ro,*) ;;
                    *)
                        uci set "fstab.$sec.options=${opts:+$opts,}errors=remount-ro"
                        fstab_changed=1
                        ;;
                esac
            ;;
        esac
    done

    # 提交 fstab 变更
    if [ "$fstab_changed" = "1" ]; then
        uci commit fstab 2>/dev/null
        logger -t "$PROG" "fstab errors=remount-ro applied"
    fi

    # 校验 /proc/mounts，如尚未生效则立即 remount（每次开机执行；
    # /overlay 非 fstab 管理（preinit 挂载），只能靠本段 live remount）
    for m in /overlay /mnt/data_sda2; do
        mountpoint -q "$m" 2>/dev/null || continue
        grep " $m " /proc/mounts | grep -q "errors=remount-ro" && continue
        mount -o remount,errors=remount-ro "$m" 2>/dev/null && \
            logger -t "$PROG" "remounted $m with errors=remount-ro"
    done

    # 2) 保持 LAN IPv6 有状态 DHCPv6（同步上游 6fe3759，原 custom_task boot 段）
    #    [如不想持久化删除此段]
    if [ "$(uci -q get dhcp.lan.ra)" != "server" ] || \
       [ "$(uci -q get dhcp.lan.dhcpv6)" != "server" ] || \
       [ "$(uci -q get dhcp.lan.ra_flags)" = "none" ]; then
        uci set dhcp.lan.dhcpv6='server'
        uci set dhcp.lan.ra='server'
        uci -q delete dhcp.lan.ra_flags
        uci add_list dhcp.lan.ra_flags='managed-config'
        uci add_list dhcp.lan.ra_flags='other-config'
        uci commit dhcp
        /etc/init.d/odhcpd restart
        logger -t "$PROG" "LAN IPv6 stateful DHCPv6 enforced"
    fi

    # 3) uhttpd 只绑回环（对抗 crash loop，2026-10 实测）:
    #    nginx 占用 80/443，uhttpd 监听 0.0.0.0:80 时一旦被运行期拉起
    #    就 bind 失败 → procd 每 5s 重启刷错日志（incarnation 可达三位数）。
    #    uhttpd 仅为 uhttpd -m 哈希工具保留（见 fix_luci_rpcd 注释），
    #    改绑 127.0.0.1:8080 后: 即使被任何组件拉起也无端口冲突、
    #    不暴露于 LAN/WAN。系统启动序中本脚本 START=19，晚于 uhttpd
    #    被拉起的时间点时通过 restart 立即生效。
    if [ "$(uci -q get uhttpd.main.listen_http)" != "127.0.0.1:8080" ]; then
        uci -q delete uhttpd.main.listen_http
        uci set uhttpd.main.listen_http='127.0.0.1:8080'
        uci commit uhttpd
        logger -t "$PROG" "uhttpd listen -> 127.0.0.1:8080 (nginx owns 80/443)"
        if pidof uhttpd >/dev/null 2>&1; then
            /etc/init.d/uhttpd restart 2>/dev/null
        fi
    fi

    return 0
}

start() {
    apply
}

boot() {
    apply
}
