CONFIG_TARGET_DEVICE_qualcommax_ipq60xx_DEVICE_link_nn6000-v2=y
CONFIG_TARGET_DEVICE_PACKAGES_qualcommax_ipq60xx_DEVICE_link_nn6000-v2="ipq-wifi-link_nn6000"
CONFIG_TARGET_ROOTFS_INITRAMFS=n

# TARGET config
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

# NSS / WiFi Firmware 说明（源码已改回 VIKINGYFY/immortalwrt main）
# 1) VIKINGYFY 分支的 NSS 不在 feed 中，而是在主仓库 package/qca-nss/ 下，
#    qualcommax/target.mk 的 DEFAULT_PACKAGES 已默认带上 kmod-qca-nss-drv/ecm/dp/
#    ssdk/crypto 等，无需 .config 显式选择；CONFIG_FEED_nss_packages 等 old 符号
#    在 VIKINGYFY 分支同样不存在，不保留。
# 2) VIKINGYFY 分支只有 ath11k-firmware-*-ddwrt 变体（无官方 ipq6018 标准包），
#    且 ipq60xx/target.mk 的 DEFAULT_PACKAGES 已默认包含 ath11k-firmware-ipq6018-ddwrt。
#    故显式开启 -ddwrt 变体（WLAN.HK.2.5.0.1 改版固件）。
# 3) qcn9074（PCIE 无线）仍不勾选：本设备只用板载 IPQ6018 AHB 无线，且用户刷 nowifi。

# WiFi Drivers and Firmware
CONFIG_PACKAGE_kmod-ath=y
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-ahb=y
# 显式禁用 PCIE 无线驱动（本设备不接 qcn9074；VIKINGYFY 默认包含 kmod-ath11k-pci）
CONFIG_PACKAGE_kmod-ath11k-pci=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018=n
CONFIG_PACKAGE_ath11k-firmware-ipq6018-ddwrt=y
CONFIG_PACKAGE_ath11k-firmware-qcn9074=n
CONFIG_PACKAGE_ath11k-firmware-qcn9074-ddwrt=n

# Compile
CONFIG_USE_APK=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# BUSYBOX
CONFIG_BUSYBOX_CUSTOM=y

# Web Server (LuCI 密码哈希 set_new_pwd 依赖 /usr/sbin/uhttpd -m)
CONFIG_PACKAGE_uhttpd=y

# Proto
CONFIG_PACKAGE_luci-proto-relay=y

# Libraries
CONFIG_PACKAGE_luci-lib-ipkg=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libopenssl-conf=y

# Disable Package
CONFIG_PACKAGE_automount=n
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_smartdns-ui=n

# DNS
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_conntrack=y

# DEFAULT SET
CONFIG_PACKAGE_default-settings=y
CONFIG_PACKAGE_default-settings-chn=y

# nftables kernel modules
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-nat6=y
CONFIG_PACKAGE_kmod-nft-fullcone=y
CONFIG_PACKAGE_kmod-nft-bridge=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-nft-netdev=y

# Additional network modules
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-bonding=y
CONFIG_PACKAGE_kmod-dsa=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# Kernel modules
CONFIG_PACKAGE_kmod-fs-exfat=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_kmod-fs-cifs=y
CONFIG_PACKAGE_kmod-fs-nfs=y
CONFIG_PACKAGE_kmod-fs-squashfs=y
CONFIG_PACKAGE_kmod-fs-overlay=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-tls=y
# kTLS: 上游 f9b0ce7 起 package/libs/openssl/Config.in 的 OPENSSL_KTLS 是无 default 的
# 裸 bool（不再由 kmod-tls 触发），原 system.sh 的 sed 已失效 → 必须在此显式开启，
# 否则 openssl 用 --disable-ktls 构建，nginx TLS 退回用户态加密（纯性能损失，无功能影响）。
# 依赖 kmod-tls（上面一行 =y）提供内核 TLS 栈。build.sh 在 defconfig 后会校验本项生效。
CONFIG_OPENSSL_KTLS=y
CONFIG_PACKAGE_kmod-tun=y

#  USB Support
CONFIG_PACKAGE_kmod-usb-acm=y
CONFIG_PACKAGE_kmod-usb-ehci=y
CONFIG_PACKAGE_kmod-usb-ohci=y
CONFIG_PACKAGE_kmod-usb-serial-qualcomm=y
CONFIG_PACKAGE_kmod-usb-serial-option=y
CONFIG_PACKAGE_kmod-usb-serial-wwan=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-extras=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb2=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-dwc3=y
CONFIG_PACKAGE_kmod-usb-xhci-hcd=y
CONFIG_PACKAGE_kmod-usb-printer=y
CONFIG_PACKAGE_kmod-usb-net=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-huawei-cdc-ncm=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_kmod-usb-net-qmi-wwan=y
CONFIG_PACKAGE_uqmi=y
CONFIG_PACKAGE_libqmi=y
CONFIG_PACKAGE_luci-proto-qmi=y
CONFIG_PACKAGE_umbim=y
CONFIG_PACKAGE_libmbim=y
CONFIG_PACKAGE_luci-proto-mbim=y
CONFIG_PACKAGE_kmod-usb-net-cdc-mbim=y
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-rtl8150=y
CONFIG_PACKAGE_kmod-usb-net-rtl8152=y
CONFIG_PACKAGE_kmod-usb-net-asix=y
CONFIG_PACKAGE_kmod-usb-net-asix-ax88179=y
CONFIG_PACKAGE_kmod-usb-net-cdc-eem=y
CONFIG_PACKAGE_kmod-usb-net-cdc-subset=y
CONFIG_PACKAGE_kmod-usb-net-ipheth=y
CONFIG_PACKAGE_kmod-usb-net-sierrawireless=y
CONFIG_PACKAGE_usb-modeswitch=y

# Package
CONFIG_PACKAGE_rng-tools=y
CONFIG_PACKAGE_autocore=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_fuse-utils=y
CONFIG_PACKAGE_ntfs3-mount=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_socat=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_sgdisk=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_resize2fs=y
CONFIG_PACKAGE_qrencode=y
CONFIG_PACKAGE_smartmontools-drivedb=y
CONFIG_PACKAGE_usbutils=y
CONFIG_PACKAGE_xz-utils=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nft-redir=y
CONFIG_PACKAGE_kmod-nft-socket=y


# WireGuard VPN
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# Enable Luci App
CONFIG_PACKAGE_luci-app-quickfile=y
CONFIG_PACKAGE_luci-app-istorex=y
CONFIG_PACKAGE_luci-app-lucky=y
# luci-app-pbr 已禁用（2026-10-24）：实测 pbr.config.enabled=0、无 rc.d 链接、无进程，
# 分流完全由 OpenClash（GEOIP,CN,DIRECT + MATCH 组）承担，pbr 属零使用重复件。
# 省 rootfs ≈ 184 KiB（pbr 152K + luci-app-pbr 36K）。
CONFIG_PACKAGE_luci-app-pbr=n
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-hd-idle=y
# luci-app-smartdns 已禁用（2026-10-23）：DNS 全链由 OpenClash fake-ip（127.0.0.1:7874）
# 接管，去广告由 OpenClash 规则级 REJECT 承担（RULE-SET,217heida,REJECT，连接层拦截
# 且配 sniffer，比 DNS 级更彻底）；smartdns 在本设备实测 enabled=0、无 rc 链接、
# 配置为包默认值，属零使用备用件。省 rootfs ≈ 614 KiB（smartdns 553K + app 50K + i18n 11K）。
# feeds 注册仍保留在 packages.sh 的 install 清单中，将来恢复只需本行改回 =y。
CONFIG_PACKAGE_luci-app-smartdns=n
CONFIG_PACKAGE_luci-app-autoreboot=y
# luci-app-sqm 已禁用（2026-10-24）：实测 uci show sqm 零配置、无进程，仅 /etc/rc.d/S50sqm
# 空转；且 SQM 的 cake 整形会绕过 NSS offload。省 rootfs ≈ 115 KiB
# （sqm-scripts 66K + luci-app-sqm 10K + 仅它依赖的 kmod-sched-cake 40K；
#  kmod-ifb 保留——kmod-qca-nss-drv-igs 也依赖它）。
CONFIG_PACKAGE_luci-app-sqm=n
CONFIG_PACKAGE_luci-app-tailscale-community=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-theme-argon=y
# luci-app-argon-config 已不再单独选装：kenzok8 的 luci-theme-argon 3.0.0-r20261016
# 把 argon-config 全部文件内置（LUCI_BASENAME:=argon-config，/etc/config/argon 为其
# conffile），与本 app 抢 10 个文件导致 apk "trying to overwrite" 打包失败。
# 主题自带 po/zh_Hans，配置界面中文不受影响。若上游回退合并，再恢复此行。
# 注意: luci/packages feed 也带同名副本（argon 主题、smartdns 及其 app、
#   tailscale-community），由 system.sh 的 dedupe_feed_packages 在构建期去重
#   （否则赢家不确定，实测 luci-app-smartdns 的源在两次构建间翻转过）。
# CONFIG_PACKAGE_luci-app-argon-config=y


